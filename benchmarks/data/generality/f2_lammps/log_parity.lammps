LAMMPS (11 Feb 2026 - Development)
KOKKOS mode with Kokkos version 5.0.2 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half
# MACE-MPA-0 / liquid water / ML-IAP memory-scan input.
# All knobs come from -var on the command line:
#   data_file    LAMMPS data file (atom_style atomic, type 1 = O, type 2 = H, Masses section present)
#   model_file   converted ML-IAP model (.pt)
#   run_steps    0 -> one force call (setup) only; N -> N MD steps
#   skin         neighbor skin in Angstrom (LAMMPS default for units metal is 2.0)
#   scale        isotropic box scale factor applied with remap (1.0 = as read; density ~ 1/scale^3)
#   dump_forces  0 -> no dump; k -> dump per-atom forces every k steps (parity checks)
#   thermo_every thermo output interval
#   seed, temp   velocity initialisation
#   dt           timestep in ps (default 0.0005 = 0.5 fs)
#   rep          replicate the box rep x rep x rep after reading (default 1)
# index-style so that "-var data_file ..." on the command line takes precedence (a later
# "variable ... index" for an existing variable is ignored; "string" style would error out)
variable        elems        index "O H"
variable data_file    index  water64_2x2x2_N1536.data
variable model_file   index  model.pt
variable run_steps    index  0
variable skin         index  2.0
variable scale        index  1.0
variable dump_forces  index  0
variable thermo_every index  1
variable seed         index  12345
variable temp         index  300.0
variable dt           index  0.0005
variable rep          index  1

units           metal
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

read_data       ${data_file}
read_data       <REPO>/examples/data/water64_1x1x1_N192.data
Reading data file ...
  orthogonal box = (0 0 0) to (12.4138 12.4138 12.4138)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  192 atoms
  read_data CPU = 0.010 seconds
if "${rep} > 1" then "replicate ${rep} ${rep} ${rep}"

if "${scale} != 1.0" then     "change_box all x scale ${scale} y scale ${scale} z scale ${scale} remap"

pair_style      mliap unified ${model_file} 0
pair_style      mliap unified 7net-0.lpass.pt 0
pair_coeff      * * ${elems}
pair_coeff      * * O H

neighbor        ${skin} bin
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        ${dt}
timestep        0.001
velocity        all create ${temp} ${seed} mom yes rot yes dist gaussian
velocity        all create 300.0 ${seed} mom yes rot yes dist gaussian
velocity        all create 300.0 12345 mom yes rot yes dist gaussian
fix             int all nve

thermo          ${thermo_every}
thermo          1
thermo_style    custom step atoms temp pe ke etotal press vol density cpu
thermo_modify   flush yes

if "${dump_forces} > 0" then     "dump f all custom ${dump_forces} forces.dump id type x y z fx fy fz"     "dump_modify f sort id format float %20.12e"
dump f all custom ${dump_forces} forces.dump id type x y z fx fy fz
dump f all custom 10 forces.dump id type x y z fx fy fz
dump_modify f sort id format float %20.12e

run             ${run_steps}
run             10

